# =============================================================================
# 注意：本文件下半部分（PORT / DATABASE_PATH / JWT_SECRET / …）描述的是已退役
# 的 backend-stub 服务（见 _archive/backend-stub/）。uRead 现在没有服务端，
# 这些变量不会被任何脚本读取；保留仅为历史参考，不要照着配置。
#
# 真正会被同步脚本读取的环境变量如下（默认值来自脚本源码）：
#   scripts/sync-notes.mjs / npm run notes:sync
#     NOTES_REPO      私有笔记仓库，默认 zhubao315/obsidian-vault
#     NOTES_PATH      笔记目录，默认 07-SOURCES/71-书籍
#     TTS_BASE_URL    TTS 服务地址，默认 http://192.168.1.3:40000/v1
#     TTS_MODEL       TTS 模型，默认 Qwen3-TTS-VoiceDesign-copy
#     TTS_VOICE       音色描述（一段中文文本；脚本内有默认值）
#     AUDIO_LIMIT     单次同步生成音频条数，默认 10
#     GITHUB_TOKEN    读取私有仓库的 PAT（CI 中用 secrets.OBSIDIAN_TOKEN 注入）
#   scripts/sync-lists.mjs / npm run lists:sync
#     NOTES_REPO      同上（复用同一个私有仓库）
#     LISTS_PATH      书单目录，默认 02-BUILD/21-uRead/Lists
#
# 本地同步用法示例（取消注释后填自己的值）：
# NOTES_REPO=zhubao315/obsidian-vault
# NOTES_PATH=07-SOURCES/71-书籍
# LISTS_PATH=02-BUILD/21-uRead/Lists
# TTS_BASE_URL=http://192.168.1.3:40000/v1
# TTS_MODEL=Qwen3-TTS-VoiceDesign-copy
# TTS_VOICE=从容清晰的青年女声，音色干净稳定，语速偏慢
# AUDIO_LIMIT=10
# =============================================================================

# ---- 以下代码属于已退役的 backend-stub（不再使用，保留仅供历史参考）----

# uRead Environment Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./data/uread.db

# Security Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
BCRYPT_ROUNDS=10

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760 # 10MB

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=dev

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
