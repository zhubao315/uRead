{
  "name": "uread",
  "version": "0.33.0",
  "description": "uRead · AI 阅读与知识萃取工作台（本地优先）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/copy-404.mjs && npm run build:publish-config && npm run books:build && npm run books:index && npm run build:fallbacks && npm run build:discovery",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs-site.mjs",
    "notes:sync": "node scripts/sync-notes.mjs",
    "notes:sync:dry": "node scripts/sync-notes.mjs --dry-run",
    "books:build": "python3 book-library/build.py",
    "build:fallbacks": "node scripts/make-fallback-pages.mjs",
    "lists:sync": "node scripts/sync-lists.mjs",
    "lists:sync:dry": "node scripts/sync-lists.mjs --dry-run",
    "publish:check": "node scripts/publish-check.mjs",
    "publish:report": "node scripts/publish-check.mjs --write",
    "content:inventory": "node scripts/content-inventory.mjs",
    "books:index": "node scripts/build-books-index.mjs",
    "verify:release": "node scripts/reconcile-release.mjs",
    "test:e2e": "playwright test",
    "publish:preview": "node scripts/publish-preview.mjs",
    "publish:approve": "node scripts/publish-approve.mjs",
    "build:discovery": "node scripts/build-discovery.mjs",
    "build:publish-config": "node scripts/copy-publish-config.mjs"
  },
  "keywords": [
    "reading",
    "notes",
    "knowledge-cards",
    "booklist",
    "harness-engineering",
    "design-system"
  ],
  "author": "uRead Team",
  "license": "MIT",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
